<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="truck">
    <static>false</static>
<link name="chassis">
      <pose>0 0 0.60 0 0 0</pose>
      <inertial>
        <mass>800.0</mass>
        <inertia>
          <ixx>300</ixx><iyy>600</iyy><izz>600</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- Cab -->
      <visual name="cab">
        <pose>1.2 0 0 0 0 0</pose>
        <geometry><box><size>1.4 1.6 0.6</size></box></geometry>
        <material><ambient>0.85 0.45 0.1 1</ambient><diffuse>0.9 0.5 0.12 1</diffuse></material>
      </visual>
      <!-- Cab windshield -->
      <visual name="windshield">
        <pose>1.2 0 0.45 0 0 0</pose>
        <geometry><box><size>1.0 1.3 0.35</size></box></geometry>
        <material><ambient>0.7 0.35 0.08 1</ambient><diffuse>0.75 0.4 0.1 1</diffuse></material>
      </visual>
      <!-- Cargo container -->
      <visual name="cargo">
        <pose>-0.6 0 0.5 0 0 0</pose>
        <geometry><box><size>2.5 1.4 1.0</size></box></geometry>
        <material><ambient>0.75 0.4 0.08 1</ambient><diffuse>0.8 0.45 0.1 1</diffuse></material>
      </visual>
      <!-- Flatbed under cargo -->
      <visual name="flatbed">
        <pose>-0.2 0 -0.1 0 0 0</pose>
        <geometry><box><size>3.6 1.6 0.15</size></box></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
      </visual>
      <collision name="chassis_col">
        <geometry><box><size>4.0 1.6 0.6</size></box></geometry>
      </collision>
    </link>

    <link name="front_left_wheel">
      <pose>1.9 0.7 0.25 1.5707963 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.07</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="rim"><geometry><cylinder><radius>0.15</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.15</length></cylinder></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        <contact><ode><kp>10000000.0</kp><kd>1.0</kd><min_depth>0.002</min_depth></ode></contact></surface></collision>
    </link>
    <link name="front_right_wheel">
      <pose>1.9 -0.7 0.25 1.5707963 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.07</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="rim"><geometry><cylinder><radius>0.15</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.15</length></cylinder></geometry>
        <surface><friction><ode><mu>0.0</mu><mu2>0.0</mu2></ode></friction>
        <contact><ode><kp>10000000.0</kp><kd>1.0</kd><min_depth>0.002</min_depth></ode></contact></surface></collision>
    </link>
    <link name="rear_left_wheel">
      <pose>-1.9 0.7 0.25 1.5707963 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.07</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="rim"><geometry><cylinder><radius>0.15</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.15</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
        <contact><ode><kp>10000000.0</kp><kd>1.0</kd><min_depth>0.002</min_depth></ode></contact></surface></collision>
    </link>
    <link name="rear_right_wheel">
      <pose>-1.9 -0.7 0.25 1.5707963 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia><ixx>0.04</ixx><iyy>0.04</iyy><izz>0.07</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>0.15</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material></visual>
      <visual name="rim"><geometry><cylinder><radius>0.15</radius><length>0.16</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.15</length></cylinder></geometry>
        <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
        <contact><ode><kp>10000000.0</kp><kd>1.0</kd><min_depth>0.002</min_depth></ode></contact></surface></collision>
    </link>


    <joint name="front_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>front_left_wheel</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>front_right_wheel</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_left_wheel</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>chassis</parent><child>rear_right_wheel</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros></ros>
      <update_rate>50</update_rate>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>1.4</wheel_separation>
      <wheel_diameter>0.5</wheel_diameter>
      <max_wheel_torque>150</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_source>1</odometry_source>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>chassis</robot_base_frame>
    </plugin>
  </model>
</sdf>