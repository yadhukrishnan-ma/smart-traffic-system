<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="intersection_world">

    <!-- Physics -->
    <physics type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Gazebo ROS state plugin -->
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
    </plugin>

    <!-- Base Grass Plane -->
    <model name="grass_plane">
      <static>true</static>
      <link name="link">
        <pose>0 0 -0.05 0 0 0</pose>
        <collision name="collision">
          <geometry>
            <box>
              <size>200 200 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>200 200 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.3 0.6 0.3 1</ambient>
            <diffuse>0.3 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- North-South Road -->
    <model name="road_ns">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.0 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>8 100 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>8 100 0.05</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- East-West Road -->
    <model name="road_ew">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.001 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>100 8 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>100 8 0.05</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Lane Markings -->
    <model name="markings">
      <static>true</static>
      <link name="link">
        <pose>0 0 0.03 0 0 0</pose>
        <!-- NS Center Lines -->
        <visual name="ns_center_1">
