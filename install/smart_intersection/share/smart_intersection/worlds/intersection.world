        <visual name="cw_w3">
          <pose>-6.5 -2 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sidewalks -->
    <model name="sidewalk_ne">
      <static>true</static>
      <link name="link">
        <pose>24 24 0.1 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>40 40 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>40 40 0.15</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="sidewalk_nw">
      <static>true</static>
      <link name="link">
        <pose>-24 24 0.1 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>40 40 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <box>
              <size>40 40 0.15</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="sidewalk_se">
      <static>true</static>
      <link name="link">
        <pose>24 -24 0.1 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>40 40 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
          </material>
        </visual>
