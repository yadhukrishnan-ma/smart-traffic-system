          <geometry>
            <box>
              <size>40 40 0.15</size>
            </box>
          </geometry>
        </collision>
      </link>
    </model>
    <model name="sidewalk_sw">
      <static>true</static>
      <link name="link">
        <pose>-24 -24 0.1 0 0 0</pose>
        <visual name="visual">
          <geometry>
            <box>
              <size>40 40 0.15</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
          </material>
        </visual>
