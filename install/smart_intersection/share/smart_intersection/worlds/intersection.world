        </visual>
        <visual name="cw_s1">
          <pose>2 -6.5 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 2 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
        <visual name="cw_s2">
          <pose>0 -6.5 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 2 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
        <visual name="cw_s3">
          <pose>-2 -6.5 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.5 2 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
        <visual name="cw_e1">
          <pose>6.5 2 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
        <visual name="cw_e2">
          <pose>6.5 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
        <visual name="cw_e3">
          <pose>6.5 -2 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
        <visual name="cw_w1">
          <pose>-6.5 2 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 0.01</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
          </material>
        </visual>
        <visual name="cw_w2">
          <pose>-6.5 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2 0.5 0.01</size>
            </box>
          </geometry>
          <material>
